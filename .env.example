# =============================================================================
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================
# Every value can also be supplied as a real environment variable, which is what
# you should do on Vercel (Project Settings > Environment Variables). Real
# environment variables take precedence over the values in this file.
#
# Only the variables below are actually read by config.py. Anything else here is
# silently ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Required in production
# -----------------------------------------------------------------------------

# Signs session cookies. Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# The app REFUSES TO START in production while this is unset or still equal to
# the development fallback, because a known key lets anyone forge a session
# cookie and become an admin.
SECRET_KEY=

# PostgreSQL connection string. Leave EMPTY for local development, which uses the
# SQLite file at ./database/emotion_app.db. Any non-sqlite value selects
# PostgreSQL, and production refuses to start without it.
#
# Supabase: Project Settings > Database > Connection string > URI (session mode)
#
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Percent-encode reserved characters in the password:
#   @ -> %40   : -> %3A   / -> %2F   # -> %23   ? -> %3F
# An unescaped @ makes the host look like garbage and fails with a misleading
# DNS error; the app prints a warning when it detects this.
DATABASE_URL=

# Project REST endpoint, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# Server-side key allowed to write to the Storage bucket. Either the new secret
# key (sb_secret_...) or the legacy service_role JWT.
#
# The publishable / anon key CANNOT manage a private bucket. Setting only the
# publishable key makes the app refuse to start rather than failing later.
SUPABASE_SECRET_KEY=

# Optional legacy alias, consulted only when SUPABASE_SECRET_KEY is empty.
SUPABASE_KEY=


# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------

# local    -> files under ./instance/uploads
# supabase -> private Supabase Storage bucket (production)
STORAGE_BACKEND=local

# Bucket used when STORAGE_BACKEND=supabase. Must be private.
STORAGE_BUCKET=emotion-images

# Create missing tables on boot. Defaults to ON for SQLite and OFF for
# PostgreSQL, where `flask db upgrade` is the supported path instead.
# AUTO_CREATE_TABLES=true

# Extra logging and the interactive debugger. Never enable in production.
# FLASK_DEBUG=true

# Turn CSRF protection off. Only useful for API clients that cannot hold a
# cookie. Leave enabled unless you know why you are disabling it.
# CSRF_ENABLED=true

# Mark session cookies Secure-only. Defaults to on when VERCEL is set.
# SESSION_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# Model and inference
# -----------------------------------------------------------------------------

# Seven class labels in the exact order the model's output layer produces them.
#
# The bundled finalfacialemotionmodel.keras does NOT contain class names, so the
# order cannot be read from the file. The default matches the checkpoint
# documented at https://huggingface.co/lokeshkumar79/facial-emotion-recognition:
#
#     Angry, Disgust, Fear, Happy, Neutral, Sad, Surprise
#
# If your model was trained with a different mapping, set it explicitly:
#
#     EMOTION_LABELS_JSON=["Angry","Disgust","Fear","Happy","Sad","Surprise","Neutral"]
#
# Getting this wrong silently mislabels every prediction, so check it against
# your training code before trusting any output.
# EMOTION_LABELS_JSON=

# Path to the Keras model, absolute or relative to the project root.
# MODEL_PATH=model/finalfacialemotionmodel.keras

# Log the raw per-face probability vector (every class, in %) to the
# "diagnostics.prediction" logger on each inference. Purely diagnostic - it
# never influences the prediction. Default: true.
# PREDICT_LOG_PROBABILITIES=true


# -----------------------------------------------------------------------------
# Timezones
# -----------------------------------------------------------------------------

# Database timestamps are always stored in UTC. Displayed timestamps are
# converted to this IANA zone (zoneinfo) in templates and Excel exports - never
# by a hardcoded offset. Default: Asia/Kolkata.
# DISPLAY_TIMEZONE=Asia/Kolkata

# Short label appended to exported column headers, e.g. "Timestamp (IST)".
# DISPLAY_TIMEZONE_LABEL=IST


# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------

# Hard cap on a single upload, in BYTES (default 16777216 = 16 MB). Exceeding it
# returns HTTP 413.
UPLOAD_LIMIT=16777216


# -----------------------------------------------------------------------------
# Live webcam detection
# -----------------------------------------------------------------------------

# Seconds between accepted frames from one user. Enforced server-side, so a
# modified client cannot flood the endpoint.
LIVE_DETECTION_INTERVAL=2

# Maximum length of one live session, in seconds.
MAX_LIVE_SESSION_SECONDS=3600

# Sliding-window rate limit on live frame requests.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=40

# Lifetime of a signed storage URL, in seconds.
SIGNED_URL_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# Pagination
# -----------------------------------------------------------------------------

# Rows per page in list views. Options are 25, 50 and 100.
PAGE_SIZE=25


# -----------------------------------------------------------------------------
# Platform (set automatically, do not set by hand)
# -----------------------------------------------------------------------------

# Set by Vercel; also enables Secure session cookies.
# VERCEL=1

# Set by Vercel; selects ProductionConfig.
# FLASK_ENV=production
